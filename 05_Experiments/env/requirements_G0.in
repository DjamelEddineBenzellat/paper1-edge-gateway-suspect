#   python3 -m venv <BASE_DIR>/venvs/paper1
#   <venv>/bin/python -m pip install --no-cache-dir torch torchvision --index-url https://download.pytorch.org/whl/cpu
#   <venv>/bin/python -m pip install --no-cache-dir opacus "flwr[simulation]" pandas wfdb scikit-learn pyyaml medmnist
